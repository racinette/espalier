{
  "exit": 0,
  "issues": [],
  "explain": {
    "clients/stripe/requestModels.ts": {
      "rule": "clients/[provider]/requestModels.ts.mjs",
      "pattern": "clients/*/requestModels.ts",
      "captures": { "provider": "stripe" }
    },
    "clients/stripe/stripe.ts": {
      "rule": "clients/[provider]/[implementation].ts.mjs",
      "pattern": "clients/*/*.ts",
      "captures": { "provider": "stripe", "implementation": "stripe" }
    }
  }
}
