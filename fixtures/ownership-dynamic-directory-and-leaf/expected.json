{
  "exit": 0,
  "issues": [],
  "explain": {
    "clients/registry.ts": {
      "exit": 0,
      "object": {
        "rule": "clients/[summary].ts.mjs",
        "pattern": "clients/*.ts",
        "captures": {
          "summary": "registry"
        }
      }
    },
    "clients/stripe/client.ts": {
      "exit": 0,
      "object": {
        "rule": "clients/[provider]/client.ts.mjs",
        "pattern": "clients/*/client.ts",
        "captures": {
          "provider": "stripe"
        }
      }
    }
  },
  "ownership": {
    "clients/registry.ts": "clients/[summary].ts.mjs",
    "clients/stripe/client.ts": "clients/[provider]/client.ts.mjs"
  }
}
