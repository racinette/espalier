{
  "exit": 1,
  "issues": [
    {
      "path": "Dockerfile",
      "code": "unexpected_path",
      "severity": "error",
      "rule": null
    },
    {
      "path": "Makefile",
      "code": "unexpected_path",
      "severity": "error",
      "rule": null
    }
  ],
  "explain": {
    "package.json": {
      "exit": 1,
      "object": {
        "path": "package.json",
        "ignoredBy": "ignore"
      }
    },
    "packages/web/package.json": {
      "exit": 1,
      "object": {
        "path": "packages/web/package.json",
        "ignoredBy": "ignore"
      }
    },
    "pnpm-lock.yaml": {
      "exit": 1,
      "object": {
        "path": "pnpm-lock.yaml",
        "ignoredBy": "ignore"
      }
    },
    "tsconfig.json": {
      "exit": 1,
      "object": {
        "path": "tsconfig.json",
        "ignoredBy": "ignore"
      }
    },
    ".github/workflows/ci.yml": {
      "exit": 1,
      "object": {
        "path": ".github/workflows/ci.yml",
        "ignoredBy": "ignore"
      }
    },
    ".vscode/settings.json": {
      "exit": 1,
      "object": {
        "path": ".vscode/settings.json",
        "ignoredBy": "ignore"
      }
    },
    "LICENSE": {
      "exit": 1,
      "object": {
        "path": "LICENSE",
        "ignoredBy": "ignore"
      }
    },
    "README.MD": {
      "exit": 0,
      "object": {
        "path": "README.MD",
        "rule": "[doc].MD.mjs",
        "pattern": "*.MD",
        "captures": {
          "doc": "README"
        }
      }
    },
    "CHANGELOG.MD": {
      "exit": 0,
      "object": {
        "path": "CHANGELOG.MD",
        "rule": "[doc].MD.mjs"
      }
    },
    "Makefile": {
      "exit": 1,
      "object": {
        "path": "Makefile",
        "rule": null,
        "recognized": null,
        "declared": []
      }
    },
    "Dockerfile": {
      "exit": 1,
      "object": {
        "path": "Dockerfile",
        "rule": null,
        "recognized": null,
        "declared": []
      }
    }
  },
  "ownership": {
    ".github/workflows/ci.yml": null,
    ".vscode/settings.json": null,
    "CHANGELOG.MD": "[doc].MD.mjs",
    "Dockerfile": null,
    "LICENSE": null,
    "Makefile": null,
    "README.MD": "[doc].MD.mjs",
    "main.ts": "main.ts.mjs",
    "package.json": null,
