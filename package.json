{
  "name": "espalier",
  "version": "0.1.0",
  "description": "An architecture compiler for agent-driven development",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "espalier": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/api.d.ts",
      "default": "./dist/src/api.js"
    }
  },
  "files": [
    "dist/src",
    "ignores"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0"
  }
}
